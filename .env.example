# Local development only. In production the key lives in Secret Manager, never in the repo.
GEMINI_API_KEY=your-key-from-google-ai-studio
# Models are tried in order. Each attempt has an 8 second limit. If both fail, a template waybill is returned.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# Only if the web app runs on a different origin locally (for example http://localhost:5173)
ALLOWED_ORIGIN=
